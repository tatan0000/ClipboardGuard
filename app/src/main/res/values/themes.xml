<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        主题公共配置。
        Theme.ClipboardGuard 只保留当前资源目录特有的窗口栏颜色；通用 Material 颜色放在 Base 中。
        暗色模式下同名颜色由 values-night/colors.xml 覆盖，避免在布局中直接写死亮/暗色。
    -->
    <style name="Theme.ClipboardGuard.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 主色 -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorPrimaryContainer">@color/color_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/color_on_primary_container</item>

        <!-- 次色 -->
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorOnSecondary">@color/color_on_secondary</item>
        <item name="colorSecondaryContainer">@color/color_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/color_on_secondary_container</item>

        <!-- 第三色 -->
        <item name="colorTertiary">@color/color_tertiary</item>
        <item name="colorOnTertiary">@color/color_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/color_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/color_on_tertiary_container</item>

        <!-- 错误色 -->
        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/color_on_error</item>
        <item name="colorErrorContainer">@color/color_error_container</item>
        <item name="colorOnErrorContainer">@color/color_on_error_container</item>

        <!-- 背景与表面 -->
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorOnBackground">@color/color_on_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_on_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/color_on_surface_variant</item>

        <!-- 轮廓 -->
        <item name="colorOutline">@color/color_outline</item>
        <item name="colorOutlineVariant">@color/color_outline_variant</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/color_background</item>

        <!-- 兼容旧属性 -->
        <item name="colorPrimaryDark">@color/color_primary_dark</item>
        <item name="colorAccent">@color/color_primary</item>
    </style>

    <!-- 浅色主题入口：只覆盖浅色窗口栏颜色。 -->
    <style name="Theme.ClipboardGuard" parent="Theme.ClipboardGuard.Base">
        <item name="android:statusBarColor">@color/color_primary</item>
        <item name="android:navigationBarColor">#FF000000</item>
    </style>

    <!-- ===== 透明对话框：Hook 内联弹窗使用 ===== -->
    <style name="Theme.Dialog.Transparent" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

    <!-- ===== Material 列表选择对话框 ===== -->
    <style name="Theme.ClipboardGuard.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog.Centered">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ClipboardGuard.LargeComponent</item>
    </style>

    <!-- ===== 底部弹窗主题 ===== -->
    <style name="Theme.Dialog.BottomSheet" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.ClipboardGuard.BottomSheet</item>
    </style>

    <style name="Widget.ClipboardGuard.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/color_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.ClipboardGuard.LargeComponent</item>
    </style>

    <!-- ===== 统一圆角形状 ===== -->
    <style name="ShapeAppearance.ClipboardGuard.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- ===== 工具栏标题文字 ===== -->
    <style name="TextAppearance.ClipboardGuard.Toolbar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">18sp</item>
    </style>

</resources>
