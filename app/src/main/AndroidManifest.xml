<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 查询其他应用包名（显示应用名称、图标） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 开机自启动权限 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- 发送通知权限（Android 13+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 前台服务权限（Android 14+ 要求） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
        TYPE_APPLICATION_OVERLAY 不需要 SYSTEM_ALERT_WINDOW 权限（Android 8.0+）
        因此移除此权限声明
    -->

    <application
        android:name=".ClipboardGuardApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClipboardGuard">

        <!-- 主界面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 写入规则详情页 -->
        <activity
            android:name=".WriteRulesDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.ClipboardGuard" />

        <!-- 读取规则详情页 -->
        <activity
            android:name=".ReadRulesDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.ClipboardGuard" />

        <!--
            配置同步前台服务
            由 BootReceiver 启动，延迟发配置广播给 Hook 侧。
            前台服务比 BroadcastReceiver.goAsync() 更可靠。
        -->
        <service
            android:name=".ConfigSyncService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="clipboard_guard_config_sync" />
        </service>

        <!--
            权限数据ContentProvider
            用于Hook代码（运行在 system_server 进程）跨进程读取本模块存储的权限数据
            android:exported="true" 必须为true以允许跨进程访问
            android:grantUriPermissions="true" 允许授予临时URI权限
        -->
        <provider
            android:name=".PermissionProvider"
            android:authorities="com.android.clipboardguard.provider"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- ======= Xposed 模块声明 ======= -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="剪贴板写入权限管理 - 应用向剪贴板写入时询问用户是否拦截" />

        <meta-data
            android:name="xposedminversion"
            android:value="82" />

        <!--
            LSPosed 推荐作用域：
            Hook 目标是 system_server 进程（android 包），
            同时需要作用域包含本模块进程，用于激活状态检测和弹窗启动
            使用 @array/xposed_scope 引用 arrays.xml 中的配置
        -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!-- 开机自启动接收器 -->
        <!-- 注册多个 Intent 作为兜底，国产 ROM 常拦截 BOOT_COMPLETED -->
        <!-- Hook 侧触发：注册成功后 2s 发显式广播（ComponentName 直达），不走 intent-filter -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <!-- 标准开机广播（可能被国产 ROM 拦截） -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Android 7.0+ 直接启动模式：加密解锁后发送，比 BOOT_COMPLETED 更早 -->
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <!-- 一加/OPPO 等机型使用 -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- 用户首次解锁屏幕（最可靠，国产 ROM 通常不拦截） -->
                <action android:name="android.intent.action.USER_PRESENT" />
                <!-- 时间/时区变化（开机时常触发，作为额外兜底） -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
