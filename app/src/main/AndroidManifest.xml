<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <permission
        android:name="com.android.clipboardguard.permission.CONFIG_SYNC"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.android.clipboardguard.permission.CONFIG_SYNC" />

    <!-- 查询其他应用包名（显示应用名称、图标） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission,QueryAllPackagesPermissionImpliesUnsupportedChromeOsHardware" />

    <!--
        TYPE_APPLICATION_OVERLAY 不需要 SYSTEM_ALERT_WINDOW 权限（Android 8.0+）
        因此移除此权限声明
    -->

    <application
        android:name=".ClipboardGuardApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClipboardGuard">

        <!-- 主界面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 写入规则详情页 -->
        <activity
            android:name=".WriteRulesDetailActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ClipboardGuard" />

        <!-- 读取规则详情页 -->
        <activity
            android:name=".ReadRulesDetailActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ClipboardGuard" />

        <!-- 写入规则应用选择页 -->
        <activity
            android:name=".WriteRuleAppsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ClipboardGuard" />

        <!-- 读取规则应用选择页 -->
        <activity
            android:name=".ReadRuleAppsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ClipboardGuard" />

        <!-- 关于模块页 -->
        <activity
            android:name=".AboutModuleActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ClipboardGuard" />

        <!--
            权限与规则配置 Provider。
            需要允许 system_server 通过 ContentResolver.call() 上报真实模块状态，
            实际调用方校验在 PermissionProvider 内按 UID 严格执行。
        -->
        <provider
            android:name=".PermissionProvider"
            android:authorities="com.android.clipboardguard.provider"
            android:exported="true"
            android:permission="com.android.clipboardguard.permission.CONFIG_SYNC"
            tools:ignore="ExportedContentProvider" />

        <!-- ======= Xposed 模块声明 ======= -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="剪贴板访问管理\n应用读取或写入剪贴板时进行内容匹配、提示与拦截\n严禁倒卖。" />

        <meta-data
            android:name="xposedminversion"
            android:value="82" />

        <!--
            LSPosed 推荐作用域：
            Hook 目标是 system_server 进程（android 包），
            激活状态以系统框架 Hook 成功为准，修改作用域后需要重启系统生效
            使用 @array/xposed_scope 引用 arrays.xml 中的配置
        -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

    </application>

</manifest>
