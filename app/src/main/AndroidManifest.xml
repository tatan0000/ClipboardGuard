<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 查询其他应用包名（显示应用名称、图标） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
        TYPE_APPLICATION_OVERLAY 不需要 SYSTEM_ALERT_WINDOW 权限（Android 8.0+）
        因此移除此权限声明
    -->

    <application
        android:name=".ClipboardGuardApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClipboardGuard">

        <!-- 主界面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            权限弹窗Activity（已废弃）
            现在使用 InlineDialogManager 在 system_server 内直接弹窗
            此 Activity 保留用于兼容性和调试
        -->
        <activity
            android:name=".PermissionDialogActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Dialog.Transparent"
            android:launchMode="singleInstance" />

        <!--
            权限数据ContentProvider
            用于Hook代码（运行在 system_server 进程）跨进程读取本模块存储的权限数据
            android:exported="true" 必须为true以允许跨进程访问
            android:grantUriPermissions="true" 允许授予临时URI权限
        -->
        <provider
            android:name=".PermissionProvider"
            android:authorities="com.android.clipboardguard.provider"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- ======= Xposed 模块声明 ======= -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="剪贴板写入权限管理 - 应用向剪贴板写入时询问用户是否拦截" />

        <meta-data
            android:name="xposedminversion"
            android:value="82" />

        <!--
            LSPosed 推荐作用域：
            Hook 目标是 system_server 进程（android 包），
            同时需要作用域包含本模块进程，用于激活状态检测和弹窗启动
            使用 @array/xposed_scope 引用 arrays.xml 中的配置
        -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

    </application>

</manifest>
